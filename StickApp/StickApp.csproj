<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>StickApp</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\JimNightshade-Regular.ttf" />
    <Resource Include="Assets\icon.ico" />
    <None Include="Assets\background.*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\icon.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
