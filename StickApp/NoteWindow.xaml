<Window x:Class="StickApp.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stickly Note"
        Icon="Assets/icon.ico"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        MinWidth="140" MinHeight="110"
        AllowDrop="True"
        Closing="NoteWindow_Closing"
        SizeChanged="NoteWindow_SizeChanged"
        LocationChanged="NoteWindow_LocationChanged"
        PreviewKeyDown="NoteWindow_PreviewKeyDown"
        Drop="NoteWindow_Drop"
        MouseEnter="NoteWindow_MouseEnter"
        MouseLeave="NoteWindow_MouseLeave">
    <Window.Resources>
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#66888888" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="New Note" Click="NewNote_Click"/>
            <Separator/>
            <MenuItem Header="Color">
                <MenuItem Header="Image Background" Click="SetColor_Click" Tag="Image"/>
                <Separator/>
                <MenuItem Header="Classic Yellow" Click="SetColor_Click" Tag="#FFF6A6"/>
                <MenuItem Header="Mint Green" Click="SetColor_Click" Tag="#D4F4DD"/>
                <MenuItem Header="Soft Blue" Click="SetColor_Click" Tag="#D0E8FF"/>
                <MenuItem Header="Pastel Pink" Click="SetColor_Click" Tag="#FFD6E8"/>
                <MenuItem Header="Lavender" Click="SetColor_Click" Tag="#E8D7FF"/>
                <MenuItem Header="Dark Charcoal" Click="SetColor_Click" Tag="#282828"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Add Photo…" Click="AddPhoto_Click"/>
            <MenuItem x:Name="ClearPhotosItem" Header="Clear All Photos" Click="ClearPhotos_Click"/>
            <Separator/>
            <MenuItem Header="Delete Note" Click="DeleteNote_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition x:Name="ImagesRow" Height="0"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4"/>
        </Grid.RowDefinitions>

        <Image x:Name="BackgroundImage" Grid.RowSpan="4" Stretch="UniformToFill" Visibility="Collapsed"/>

        <Border x:Name="Header" Grid.Row="0" Background="#18000000"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid Margin="4,0,4,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="NewNoteButton" Content="＋" ToolTip="New note"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            Width="20" Height="20"
                            FontSize="12" FontWeight="Bold"
                            Visibility="Collapsed"
                            Click="NewNote_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="AddPhotoButton" Content="📷" ToolTip="Add photo"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            Width="20" Height="20" Margin="0,0,2,0"
                            FontSize="11"
                            Visibility="Collapsed"
                            Click="AddPhoto_Click"/>
                    <Button x:Name="DeleteButton" Content="✕" ToolTip="Delete note"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            Width="20" Height="20"
                            FontSize="11" FontWeight="Bold"
                            Visibility="Collapsed"
                            Click="DeleteNote_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Margin="4,4,4,0">
            <StackPanel x:Name="ImagesPanel" Orientation="Horizontal"/>
        </ScrollViewer>

        <TextBox x:Name="NoteText" Grid.Row="2"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 BorderThickness="0" Background="Transparent"
                 VerticalScrollBarVisibility="Auto"
                 Padding="8,4,8,8"
                 FontFamily="./Assets/#Jim Nightshade, Segoe UI, Arial" FontSize="15"
                 TextChanged="NoteText_TextChanged"/>

        <Border x:Name="Footer" Grid.Row="3" Background="#15000000"/>
    </Grid>
</Window>
