<Window x:Class="StickApp.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Note"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        MinWidth="120" MinHeight="100"
        AllowDrop="True"
        SourceInitialized="NoteWindow_SourceInitialized"
        Closing="NoteWindow_Closing"
        SizeChanged="NoteWindow_SizeChanged"
        LocationChanged="NoteWindow_LocationChanged"
        PreviewKeyDown="NoteWindow_PreviewKeyDown"
        Drop="NoteWindow_Drop"
        MouseEnter="NoteWindow_MouseEnter"
        MouseLeave="NoteWindow_MouseLeave">
    <Window.Resources>
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#5C0A14"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Black">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#555555" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Add Photo…" Click="AddPhoto_Click"/>
            <MenuItem x:Name="ClearPhotosItem" Header="Clear All Photos" Click="ClearPhotos_Click"/>
            <Separator/>
            <MenuItem Header="Delete Note" Click="DeleteNote_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition x:Name="ImagesRow" Height="0"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4"/>
        </Grid.RowDefinitions>

        <Image x:Name="BackgroundImage" Grid.RowSpan="4" Stretch="UniformToFill" Visibility="Collapsed"/>

        <Border x:Name="Header" Grid.Row="0" Background="#22000000"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Button x:Name="DeleteButton" Content="✕" ToolTip="Delete note"
                        Style="{StaticResource HeaderIconButtonStyle}"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Width="20" Height="18" Margin="2,0,0,0" Padding="0"
                        FontSize="10" Foreground="White" BorderThickness="0"
                        Visibility="Collapsed"
                        Click="DeleteNote_Click"/>
                <Button x:Name="AddPhotoButton" Content="+" ToolTip="Add photo"
                        Style="{StaticResource HeaderIconButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="20" Height="18" Margin="0,0,2,0" Padding="0"
                        FontSize="13" FontWeight="Bold" Foreground="White" BorderThickness="0"
                        Visibility="Collapsed"
                        Click="AddPhoto_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Margin="4,4,4,0">
            <StackPanel x:Name="ImagesPanel" Orientation="Horizontal"/>
        </ScrollViewer>

        <TextBox x:Name="NoteText" Grid.Row="2"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 BorderThickness="0" Background="Transparent"
                 VerticalScrollBarVisibility="Auto"
                 Padding="6"
                 FontFamily="Arial Black" FontSize="11.5"
                 Foreground="Yellow" CaretBrush="Yellow"
                 TextChanged="NoteText_TextChanged"/>

        <Border x:Name="Footer" Grid.Row="3" Background="White"/>
    </Grid>
</Window>
